# Local development only. Never commit the populated .env.
ZEROBUS_SERVER_ENDPOINT=https://<numeric-workspace-id>.zerobus.<region>.cloud.databricks.com
DATABRICKS_WORKSPACE_URL=https://<your-workspace-host>
DATABRICKS_WORKSPACE_ID=<numeric-workspace-id>
ZEROBUS_TABLE_NAME=<catalog>.<schema>.efuse_events_zerobus
DATABRICKS_CLIENT_ID=<service-principal-client-id>
DATABRICKS_CLIENT_SECRET=<oauth-client-secret>
ZEROBUS_EVENT_COUNT=10
# Optional:
# ZEROBUS_EVENT_PREFIX=
